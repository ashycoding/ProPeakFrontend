# ProPeak Public Website - Frontend Environment Variables
# Copy this file to '.env' or set these variables in your hosting provider (Vercel / Netlify / Cloudflare Pages)

# Public canonical site URL (Used for SEO, Open Graph & Canonical links)
VITE_SITE_URL=https://propeak.in

# Google Form URL for project intake
VITE_GOOGLE_PROJECT_FORM_URL=https://forms.gle/oTRxffbuEJQiLFee6

# Primary contact email address
VITE_CONTACT_EMAIL=propeak03@gmail.com

# Social Links (Only rendered when URL is provided)
VITE_LINKEDIN_URL=https://www.linkedin.com/company/propeak-in/
VITE_INSTAGRAM_URL=
VITE_GITHUB_URL=
VITE_YOUTUBE_URL=
VITE_WHATSAPP_URL=

# Optional Analytics ID (Google Analytics / Plausible / PostHog)
VITE_ANALYTICS_ID=
